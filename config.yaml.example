# ==============================================================================
# Code-Shield 🛡️ 服务端配置规范模版 (config.yaml.example)
#
# 架构规范版本: CS-NATIVE-02
#
# ⚠️ 注意事项与动静分层：
# 1. 基础设施层 (server, storage, database, auth)：
#    属于静态引导冷配置，系统启动时直接从本文件加载。修改需重启服务。
# 2. 动态业务中心层 (llm, scanner, governance, notification)：
#    本文件中的内容仅在系统首次安装部署（数据库为空）时作为初始种子数据导入数据库；
#    系统初始化后，以数据库 (DB SSOT) 为唯一真值源，请直接在 Web 管理界面 (/admin/config) 实时调整，无需重启服务。
# ==============================================================================

# ==============================================================================
# 1. 基础设施层 (纯粹的静态低频冷配置)
# ==============================================================================
server:
  port: ":8080"                         # HTTP 服务监听端口
  external_url: "http://192.168.56.18:8080" # 外部访问基准 URL (用于邮件通知与报告外链跳转)
  read_timeout: 120s                    # HTTP 请求读取超时
  write_timeout: 120s                   # HTTP 响应写入超时
  idle_timeout: 180s                    # HTTP Keep-Alive 空闲保持超时

storage:
  root: "."                             # 数据根目录，下设 codes/ (缓存) 与 reports/ (报告)

database:
  driver: "postgres"                    # 数据库驱动，固定为 postgres
  host: "127.0.0.1"                     # PostgreSQL 主机地址
  port: 5432                            # PostgreSQL 端口
  user: "postgres"                      # 数据库用户名
  password: "CodeShield618!"            # 数据库密码
  dbname: "code_shield"                 # 数据库名称
  sslmode: "disable"                    # SSL 模式: disable, require, verify-ca, verify-full
  timezone: "Asia/Shanghai"             # 会话时区
  max_open_conns: 50                    # 连接池最大打开连接数
  max_idle_conns: 10                    # 连接池最大空闲连接数

auth:
  jwt_secret: "ABCDEFGHIJKLMNOPQRSTVUWXYZ0987654321" # JWT 签名密钥 (生产环境请务必修改)
  password_login_enabled: true         # 是否启用账号密码登录

  oauth2:
    enabled: true                      # 是否启用 OAuth2 / OIDC 单点登录
    client_id: "code-shield"           # Client ID
    client_secret: ""                  # Client Secret
    auth_url: "https://sso.yourcompany.com/realms/main/protocol/openid-connect/auth"
    token_url: "https://sso.yourcompany.com/realms/main/protocol/openid-connect/token"
    userinfo_url: "https://sso.yourcompany.com/realms/main/protocol/openid-connect/userinfo"
    redirect_url: ""                   # 回调地址，留空自动推导
    scopes: ["openid", "profile", "email"]
    admin_list: ["fugui", "admin@company.com"] # SSO 登录自动提权为系统管理员的邮箱/用户名白名单
    field_mapping:
      username: "preferred_username"
      email: "email"
      name: "name"
      employee_id: "employee_id"
      unique_id: "unique_id"
      employee_type: "employee_type"
    dept_api_url: "https://sso.yourcompany.com/realms/main/custom/department"

# ==============================================================================
# 2. 大模型与算力供给池 (LLM Compute Resources & Endpoints - 初次导入种子模版)
# 职责：专注解决“模型是什么、API在何处、物理并发多大、如何负载分流”
# ==============================================================================
llm:
  default_resource: "native"           # 全局兜底 Resource ID
  debug_logs: false                    # 是否输出大模型底层交互调试日志

  # 算力节点资源池
  resources:
    # 节点 1: Antigravity CLI 探索型 Thick Agent (初筛与复杂代码探索)
    - id: "agy"
      driver: "agy"                     # 驱动类型: agy / opencode / claude / codex / native
      model: "gemini-3.7-flash"
      concurrent: 5                     # 该节点最大物理并发槽位

    # 节点 2: OpenCode 算力节点 (备选 Thick Agent)
    - id: "opencode"
      driver: "opencode"
      model: "models/glm5.1"
      concurrent: 5

    # 节点 3: 原生 Thin LLM 执行引擎 (统一 ID 为 native，内含高并发算力集群 endpoints)
    - id: "native"
      driver: "native"
      model: "deepseek-v4-flash-vision-exp"
      concurrent: 10
      base_url: "https://api.deepseek.com/v1/chat/completions"
      api_key: "sk-be919fc7cb9d429abffbf7e2c0aabb3a"
      response_format_json: false
      max_retries: 3                   # 最大重试次数
      retry_backoff_ms: 500            # 指数退避基准时长 (毫秒)

      # ── 多端点算力集群 (支持加权负载打散与故障转移，weight 为相对比例) ──
      endpoints:
        - name: "deepseek-primary"
          base_url: "https://api.deepseek.com/v1/chat/completions"
          api_key: "sk-be919fc7cb9d429abffbf7e2c0aabb3a"
          model: "deepseek-v4-flash-vision-exp"
          concurrent: 10
          weight: 100

# ==============================================================================
# 3. 智能扫描引擎与任务调度 (Scanner & Debate Pipeline Engine - 初次导入种子模版)
# 职责：专注解决“任务如何排队、如何避峰、Hunter/Reasoning/Synthesis 阶梯流水线如何执行”
# ==============================================================================
scanner:
  # 任务并发与排队队列
  worker_count: 5                      # 全局扫描任务并发 Worker 数 (根据大模型并发综合推导)
  max_queue_size: 2000                 # 待处理扫描任务排队最大上限 (超限返回 HTTP 429，-1 为无上限)
  mock_on_missing_cli: false           # CLI 未就绪时是否阻断或模拟 (生产建议 false)

  # 全局流控与避峰策略 (Throttling & Work Hours)
  throttling:
    work_hours:
      enabled: false                   # 是否开启工作时间自动限流
      workdays: [1, 2, 3, 4, 5]        # 生效星期 (周一至周五)
      start_time: "09:00"              # 限流开始时刻 (HH:MM)
      end_time: "22:00"                # 限流结束时刻 (HH:MM)
      scale: 0.10                      # 工作时间并发比例 (0.10 代表 10%，0.0 代表完全暂停)

  # 多智能体对抗辩论流水线 (Debate Pipeline)
  debate:
    enabled: true                      # 是否启用多智能体对抗辩论流水线
    fast_pass_enabled: true            # 0 候选快速放行 (节省 80%+ 辩论算力)
    max_candidates_per_chunk: 20       # 单分片最大仲裁候选数
    stage_timeout_seconds: 1800        # 单阶段全局硬超时兜底 (秒，默认 30 分钟)
    backpressure_threshold: 30         # 跨 Tier 背压触发积压阈值
    backpressure_timeout_seconds: 120  # 背压超时兜底 (秒)
    log_retention_days: 30             # 辩论轨迹日志保留天数

    # 各阶段阶梯显式绑定 llm.resources 节点
    tiers:
      tier1_hunter:                    # Tier 1 初筛 (Hunter 角色，Thick Agent 探索遍历源码)
        resource: "agy"                # 显式精确绑定 agy 节点
        timeout_seconds: 1200          # 初筛单片超时 (秒)

      tier2_reasoning:                 # Tier 2 推理与仲裁 (统一承载 Challenger 与 Judge 深度推理)
        resource: "agy"                # 显式精确绑定 agy 节点 (或 native)
        timeout_seconds: 1800          # 辩论仲裁单片超时 (秒)

      tier3_synthesis:                 # Tier 3 全仓态势汇总 (Synthesis 角色，报告聚合)
        resource: "native"             # 显式精确绑定 native 算力集群
        timeout_seconds: 300           # 报告汇总超时 (秒)

  # 内置场景微任务路由 (Utility Tools Routing)
  tools:
    default_resource: "native"         # 默认统一走 native
    overrides:
      repair_json: "native"
      finding_match: "native"
      feedback_extraction: "native"

# ==============================================================================
# 4. 企业多任务治理与历史记忆闭环 (Enterprise Governance - 初次导入种子模版)
# 职责：专注解决“质量红线、缺陷指纹防抖、范围守卫、PR门禁与知识沉淀”
# ==============================================================================
governance:
  # 跨扫描缺陷抗抖动指纹
  fingerprint:
    enabled: true                      # 启用抗行号抖动的语义缺陷指纹
    similarity_threshold: 0.85         # 跨版本模糊匹配相似度门限

  # 缺陷生命周期与门禁状态
  lifecycle:
    scope_guard_enabled: true          # 扫描范围守卫 (杜绝局部扫描产生的假修复)
    auto_resolve_missing: true         # 守卫范围内消失的缺陷自动标记为 RESOLVED
    diff_gate_strict: true             # PR/MR 门禁流水线仅阻断 [NEW] 增量缺陷

  # 研发误报记忆与反馈注入
  feedback_memory:
    injection_enabled: true            # 自动将研发标记的误报规则注入 Prompt
    max_rules_injected: 10             # 单次扫描最大注入负样本规则数 (防 Prompt 溢出)

# ==============================================================================
# 5. 事件通知服务 (Notification - 初次导入种子模版)
# ==============================================================================
notification:
  webhook: "http://127.0.0.1:8081/api/notify/email" # 通知回调地址
