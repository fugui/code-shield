# ============================================================
# Code Shield 服务端配置模版文件 (config.yaml.example)
# 使用方法：复制本文件为 config.yaml，并根据实际情况修改配置值
# ============================================================

# ── HTTP 与基础服务 ──
server:
  port: ":8080"                  # 服务监听端口
  data_dir: "./data"             # 运行时数据根目录，自动存放 codes/ 缓存和 reports/ 报告（建议配置为绝对路径；tasks/ 模版随程序目录走，无需放入数据盘）
  # external_url: "http://127.0.0.1:8080"  # 外部访问基准 URL（邮件等通知链接跳转，缺省默认为本地端口地址）
  # worker_count: 5              # 全局任务并发数，默认 5
  # max_queue_size: 2000         # 任务排队最大上限，默认 2000，-1 表示不限制
  # gin_log: true                # 是否打印 GIN 框架请求日志，默认 false
  read_timeout: 120s           # 读取 HTTP 请求超时时间，默认 120s
  write_timeout: 120s          # 写入响应超时时间，默认 120s
  idle_timeout: 180s           # keep-alive 空闲连接超时时间，默认 180s

# ── 数据库 ──
database:
  host: "127.0.0.1"              # PostgreSQL 数据库主机地址
  port: 5432                     # PostgreSQL 端口
  user: "code_shield"            # 数据库用户名
  password: "code_shield_password" # 数据库密码
  dbname: "code_shield"          # 数据库名称
  sslmode: "disable"             # SSL 模式：disable, require, verify-ca, verify-full
  max_open_conns: 50             # 最大打开连接数
  max_idle_conns: 10             # 最大空闲连接数

# ── AI 引擎 ──
ai:
  backend: "claude"              # AI 驱动 CLI 后端：可选 claude、opencode 或 codex，默认 claude
  # debug_logs: true             # 是否输出 AI 引擎底层的 debug 级别日志，默认 false。开启后会在报告同级目录下生成 .debug.log 文件方便定位
  # output_format: "text"        # AI 输出的格式：text 或 json（对 claude 来说是 text/stream-json，对 opencode 来说是 default/json；codex 的输出格式由提示词契约控制，CLI 不使用 --json），默认 text
  # mock_on_missing_cli: true    # CLI 未安装时是否写入空发现模拟报告（默认 true，建议生产环境显式改为 false 以避免静默"全绿"）

  # ── 原生轻量大模型引擎配置 (Thin LLM Engine) ──
  # 支持 OpenAI 兼容规范的标准 REST API 直接通信，毫秒级连接复用，专用于确定性单轮推理
  native:
    base_url: "http://192.168.56.18:8000/v1/chat/completions" # 原生兼容 REST API 地址
    api_key: "sk-code-shield-internal"                       # API Key (或通过环境变量 CODE_SHIELD_AI_NATIVE_API_KEY 注入)
    default_model: "glm-4-flash"                             # 默认模型
    temperature: 0.1
    max_tokens: 4096
    response_format_json: true
    max_retries: 3
    retry_backoff_ms: 500

    # 支持多异构算力端点集群 (可选，配置后将自动进行节点负载与故障转移)
    # endpoints:
    #   - name: "local-vllm-primary"
    #     base_url: "http://192.168.56.18:8000/v1/chat/completions"
    #     api_key: "sk-token-primary"
    #     model: "glm-4-flash"
    #     concurrent: 30
    #     weight: 80
    #   - name: "local-vllm-backup"
    #     base_url: "http://192.168.56.19:8000/v1/chat/completions"
    #     api_key: "sk-token-backup"
    #     model: "qwen-2.5-72b-instruct"
    #     concurrent: 15
    #     weight: 20

  # ── 场景级内嵌工具专有后端路由 (Tool Backends) ──
  # 为轻量级确定性工具指定独立的 AI 执行后端 (默认 native)
  tool_backends:
    repair_json: "native"           # JSON 语法修复工具
    finding_match: "native"         # 缺陷指纹跨周期语义比对
    feedback_extraction: "native"   # 误报特征知识提炼

  # ── 工作时间自动限流配置 (可选) ──
  # 开启后，系统将在指定的工作日与时间段内自动降低并发（如 10% 或 0% 暂停），非工作时间/夜间自动恢复 100% 满速。
  # work_hours_throttle:
  #   enabled: true                 # 是否启用工作时间自动限流，默认 false
  #   workdays: [1, 2, 3, 4, 5]     # 生效星期: 1=周一, 2=周二, 3=周三, 4=周四, 5=周五, 6=周六, 7=周日
  #   start_time: "09:00"           # 开始限流时刻 (HH:MM)
  #   end_time: "22:00"             # 结束限流时刻 (HH:MM)
  #   scale: 0.10                   # 工作时间内的并发比例 (0.10 代表 10%，0.0 代表完全暂停)

  # ── 多 LLM 服务器并发配置 (可选 - 算力供给端) ──
  # 启用多 LLM 服务器配置时，全局任务并发数限制会被本配置的并发总和自动拓展，
  # 每次 AI 扫描时根据后端类型自动映射对应的模型名称，并按负载最低原则分发，精准控制每台服务器的并发负载。
  # 注：使用 Codex 引擎需确保环境中配置了 OPENAI_API_KEY；使用 agy 引擎需确保环境中已安装 agy CLI。
  # models:
  #   - opencode: "models/glm5.1"
  #     claude: "glm5.1"
  #     codex: "gpt-5.6-sol"
  #     agy: "gemini-3.7-flash"
  #     concurrent: 5
  #   - codex: "o3-mini"
  #     agy: "gemini-3.7-pro"
  #     concurrent: 3
  #
  # ── 异构模型多阶梯资源池配置 (可选 - 业务需求端) ──
  # 为多智能体流水线的不同业务环节配置专门的快/强模型与独立超时时限（详见使用手册 4.6 章节）。
  # tiers:
  #   tier1_fast:                    # Tier 1 快排初筛 (高并发、低成本)
  #     backend: "agy"               # 可选 agy / opencode / claude / codex
  #     model: "gemini-3.7-flash"
  #     concurrent: 5
  #     timeout_seconds: 1200        # 初筛阶段单片超时时限 (秒，如 1200 代表 20 分钟)
  #   tier2_reasoning:               # Tier 2 强推理对抗 (Challenger 辩护与 Judge 终审)
  #     backend: "agy"
  #     model: "gemini-3.7-pro"
  #     concurrent: 3
  #     timeout_seconds: 1800        # 辩论与裁决阶段单片超时时限 (秒，如 1800 代表 30 分钟)
  #   tier3_synthesis:               # Tier 3 报告排版汇总
  #     backend: "agy"
  #     model: "gemini-3.7-flash"
  #     concurrent: 2
  #     timeout_seconds: 900         # 报告汇总阶段超时时限 (秒，如 900 代表 15 分钟)
  #
  # ── 多智能体对抗辩论与流水线流控配置 (可选) ──
  # debate:
  #   enabled: true                  # 是否开启三方交叉辩论流水线
  #   fast_pass_enabled: true        # 开启零候选快速放行 (无疑点直接跳过辩论，节省算力)
  #   max_candidates_per_chunk: 20   # 单分片进入辩论的候选点上限 (防异常爆炸)
  #   stage_timeout_seconds: 1800    # 单阶段全局硬超时兜底 (秒，如 1800 代表 30 分钟)
  #   log_retention_days: 30         # 辩论轨迹 JSON 日志保留天数
  #   backpressure_threshold: 30     # 跨 Tier 背压触发积压阈值
  #   backpressure_timeout_seconds: 120 # 背压超时兜底（秒），超时后降级为 Hunter 直出
  #   log_redaction_enabled: false   # 是否启用辩论日志脱敏

# ── 企业多任务治理与历史记忆闭环配置 (阶段三，可选) ──
# governance:
#   fingerprint_enabled: true        # 是否启用跨扫描缺陷指纹计算
#   scope_guard_enabled: true        # 启用扫描范围守卫 (仅在文件成功被扫描时才允许自动标记 RESOLVED)
#   auto_resolve_missing: true       # 本次未出现的历史存量缺陷自动标记为已修复 (RESOLVED)
#   feedback_injection: true         # 是否将已标记误报/不予修复的知识自动注入下次 Prompt
#   diff_gate_strict: true           # PR 门禁模式下是否仅阻断 [NEW] 增量缺陷

# ── 通知服务 ──
notification:
  webhook: "http://127.0.0.1:8081/api/notify/email"  # 分析完毕后发送报告卡片通知的回调地址

# ── 认证与单点登录配置 ──
auth:
  standalone_mode: false             # 是否以独立系统模式运行（false: 微前端模式，依赖主门户；true: 独立部署运行）
  jwt_secret: ""                     # JWT 签名密钥（用于校验由 code-bench 签发或本系统签发的 Token；留空则启动时随机生成临时密钥）
  password_login_enabled: true       # 独立模式下是否启用本地账号密码登录
  oauth2:                            # 独立模式下的企业 OAuth2/OIDC 单点登录配置
    enabled: false                   # 是否启用独立 SSO
    client_id: ""                    # Client ID
    client_secret: ""                # Client Secret
    auth_url: ""                     # Authorization Endpoint
    token_url: ""                    # Token Endpoint
    userinfo_url: ""                 # UserInfo Endpoint
    redirect_url: ""                 # 回调地址，如 http://192.168.56.18:8080/api/oauth2/callback
    scopes: ["openid", "profile", "email"]
    admin_list:                      # 默认设为管理员的邮箱列表
      - "admin@code-shield.com"
    allowed_email_domains:           # 允许通过 SSO 登录的邮箱后缀白名单，留空表示不限制
      - "@yourcompany.com"
    field_mapping:
      username: "preferred_username"
      email: "email"
      name: "name"
      employee_id: "employee_id"
      unique_id: "unique_id"
      employee_type: "employee_type"

