# ==============================================================================
# Code-Shield 🛡️ 服务端配置规范模版 (config.yaml.example)
#
# 架构规范版本: CS-NATIVE-02
#
# ⚠️ 注意事项与动静分层：
# 1. 基础设施层 (server, storage, database, auth)：
#    属于静态引导冷配置，系统启动时直接从本文件加载。修改需重启服务。
# 2. 动态业务中心层 (llm, scanner, governance, notification)：
#    本文件中的内容仅在系统首次安装部署（数据库为空）时作为初始种子数据导入数据库；
#    系统初始化后，以数据库 (DB SSOT) 为唯一真值源，请直接在 Web 管理界面 (/admin/config) 实时调整，无需重启服务。
# ==============================================================================

# ==============================================================================
# 1. 基础设施层 (纯粹的静态低频冷配置)
# ==============================================================================
server:
  port: ":8080"                         # HTTP 服务监听端口
  external_url: "http://192.168.56.18:8080" # 外部访问基准 URL (用于邮件通知与报告外链跳转)
  read_timeout: 120s                    # HTTP 请求读取超时
  write_timeout: 120s                   # HTTP 响应写入超时
  idle_timeout: 180s                    # HTTP Keep-Alive 空闲保持超时

storage:
  root: "."                             # 数据根目录，下设 codes/ (缓存) 与 reports/ (报告)

database:
  driver: "postgres"                    # 数据库驱动，固定为 postgres
  host: "127.0.0.1"                     # PostgreSQL 主机地址
  port: 5432                            # PostgreSQL 端口
  user: "postgres"                      # 数据库用户名
  password: "CodeShield618!"            # 数据库密码
  dbname: "code_shield"                 # 数据库名称
  sslmode: "disable"                    # SSL 模式: disable, require, verify-ca, verify-full
  timezone: "Asia/Shanghai"             # 会话时区
  max_open_conns: 50                    # 连接池最大打开连接数
  max_idle_conns: 10                    # 连接池最大空闲连接数

auth:
  jwt_secret: "ABCDEFGHIJKLMNOPQRSTVUWXYZ0987654321" # JWT 签名密钥 (生产环境请务必修改)
  password_login_enabled: true         # 是否启用账号密码登录

  oauth2:
    enabled: true                      # 是否启用 OAuth2 / OIDC 单点登录
    client_id: "code-shield"           # Client ID
    client_secret: ""                  # Client Secret
    auth_url: "https://sso.yourcompany.com/realms/main/protocol/openid-connect/auth"
    token_url: "https://sso.yourcompany.com/realms/main/protocol/openid-connect/token"
    userinfo_url: "https://sso.yourcompany.com/realms/main/protocol/openid-connect/userinfo"
    redirect_url: ""                   # 回调地址，留空自动推导
    scopes: ["openid", "profile", "email"]
    admin_list: ["fugui", "admin@company.com"] # SSO 登录自动提权为系统管理员的邮箱/用户名白名单
    field_mapping:
      username: "preferred_username"
      email: "email"
      name: "name"
      employee_id: "employee_id"
      unique_id: "unique_id"
      employee_type: "employee_type"
    dept_api_url: "https://sso.yourcompany.com/realms/main/custom/department"

# ==============================================================================
# 2. 大模型与算力供给池 (LLM Compute Resources & Endpoints - 初次导入种子模版)
# 职责：专注解决“模型是什么、API在何处、物理并发多大、如何负载分流”
# ==============================================================================
llm:
  default_resource: "native"           # 全局兜底 Resource ID
  debug_logs: false                    # 是否输出大模型底层交互调试日志

  # 算力节点资源池
  resources:
    # 节点 1: Antigravity CLI 探索型 Thick Agent (初筛与复杂代码探索)
    - id: "agy"
      driver: "agy"                     # 驱动类型: agy / opencode / claude / codex / native
      model: "gemini-3.7-flash"
      concurrent: 5                     # 该节点最大物理并发槽位

    # 节点 2: OpenCode 算力节点 (备选 Thick Agent)
    - id: "opencode"
      driver: "opencode"
      model: "modelgate/GLM-4.7-XS"
      concurrent: 5

    # 节点 3: 原生 Thin LLM 执行引擎 (统一 ID 为 native，内含高并发算力集群 endpoints)
    - id: "native"
      driver: "native"
      model: "deepseek-v4-flash-vision-exp"
      concurrent: 10
      base_url: "https://api.deepseek.com/v1/chat/completions"
      api_key: "sk-be919fc7cb9d429abffbf7e2c0aabb3a"
      response_format_json: false
      enable_thinking: false           # false 下发 "thinking": {"type":"disabled"}；true 时不下发该字段
      max_tokens: 32768                # text 流默认上限；同时仍有 MaxOutputBytes 字节保护
      attempt_timeout_seconds: 300     # 单次 Native HTTP attempt 超时
      first_byte_timeout_seconds: 60   # SSE 首包看门狗
      idle_timeout_seconds: 60         # SSE 空闲看门狗
      max_output_bytes: 32768          # Markdown/文本流输出上限
      max_retries: 3                   # 最大重试次数
      retry_backoff_ms: 500            # 指数退避基准时长 (毫秒)

      # ── 多端点算力集群 (支持加权负载打散与故障转移，weight 为相对比例) ──
      endpoints:
        - name: "deepseek-primary"
          base_url: "https://api.deepseek.com/v1/chat/completions"
          api_key: "sk-be919fc7cb9d429abffbf7e2c0aabb3a"
          model: "deepseek-v4-flash-vision-exp"
          concurrent: 10
          weight: 100

# ==============================================================================
# 3. 智能扫描引擎与任务调度 (Scanner & Debate Pipeline Engine - 初次导入种子模版)
# 职责：专注解决“任务如何排队、如何避峰、Hunter/Reasoning/Synthesis 阶梯流水线如何执行”
# ==============================================================================
scanner:
  # 任务并发与排队队列
  worker_count: 5                      # 全局扫描任务并发 Worker 数 (根据大模型并发综合推导)
  max_queue_size: 2000                 # 待处理扫描任务排队最大上限 (超限返回 HTTP 429，-1 为无上限)
  mock_on_missing_cli: false           # CLI 未就绪时是否阻断或模拟 (生产建议 false)

  # 通用 AI 分析的业务层重试策略 (单 chunk / 单仓分析；不包含 native endpoint failover)
  analysis:
    max_retries: 3                     # 首次失败后的最大重试次数，总尝试次数为 max_retries + 1
    retry_backoff_ms: 2000             # 指数退避基准：2s / 4s / 8s...
    max_backoff_seconds: 30            # 单次重试等待上限
    retryable_errors:                  # 只允许对以下类型化错误进行业务层重试
      - "rate_limited"
      - "network_transient"
      - "unknown"                      # 兼容项：未分类错误；生产稳定后建议移除，详见恢复治理设计文档

  # OpenCode Thick Agent 失败恢复 (复用同一 session，只补写目标输出)
  opencode:
    continuation:
      enabled: true                    # 默认开启；设置为 false 可完全回滚为立即失败
      max_seconds: 300                 # 单次续跑预算上限，且不超过原请求剩余预算

  # 扫描 checkpoint 兼容策略
  resume:
    # v2 bundle checkpoint 写盘时还没有 artifact 完整性状态。
    # 默认 reject 会重扫；确认旧 checkpoint 不含 quarantined candidate 后才可切换。
    legacy_v2_policy: reject

  # 全局流控与避峰策略 (Throttling & Work Hours)
  throttling:
    work_hours:
      enabled: false                   # 是否开启工作时间自动限流
      workdays: [1, 2, 3, 4, 5]        # 生效星期 (周一至周五)
      start_time: "09:00"              # 限流开始时刻 (HH:MM)
      end_time: "22:00"                # 限流结束时刻 (HH:MM)
      scale: 0.10                      # 工作时间并发比例 (0.10 代表 10%，0.0 代表完全暂停)

  # 多智能体对抗辩论流水线 (Debate Pipeline)
  debate:
    enabled: true                      # 是否启用多智能体对抗辩论流水线
    fast_pass_enabled: true            # 0 候选快速放行 (节省 80%+ 辩论算力)
    max_candidates_per_chunk: 20       # 单分片最大仲裁候选数
    stage_timeout_seconds: 1800        # 单阶段全局硬超时兜底 (秒，默认 30 分钟)
    backpressure_threshold: 30         # 跨 Tier 背压触发积压阈值
    backpressure_timeout_seconds: 120  # 背压超时兜底 (秒)
    log_retention_days: 30             # 辩论轨迹日志保留天数

    # 各阶段阶梯显式绑定 llm.resources 节点 (支持单一 resource 或 resources 候选资源池多选)
    tiers:
      tier1_hunter:                    # Tier 1 源码初筛 (Hunter 角色，Thick Agent 探索遍历源码)
        resource: "agy"                # 兼容首选字段
        resources: ["agy", "opencode"] # 多 Thick Agent 资源池化负载打散 (10 并发初筛)
        attempt_timeout_seconds: 1800  # 每次 Hunter AI 调用上限 (秒)
        timeout_seconds: 7200          # Hunter 拆片总预算 (秒)，覆盖首次调用与二分重试
        idle_timeout_seconds: 600      # 初筛空闲看门狗 (秒)，无 stdout/stderr 活动提前判死
        timeout_recovery: "split"      # 超时恢复策略: split / retry / fail
        max_split_depth: 8             # 语义分片二分深度上限（额外保护，不替代总预算）
        recovery:
          max_total_attempts: 3              # stage 总逻辑尝试数
          max_attempts_per_resource: 3       # 普通 retry 不切换 resource
          max_candidate_failovers: 0         # 候选资源切换默认关闭
          retry_backoff_ms: 2000             # retry 前退避
          max_backoff_seconds: 15            # retry 退避上限
          split_on: ["idle_timeout", "timeout"] # 可拆分 bundle 的优先恢复
          retry_on: ["idle_timeout", "timeout", "output_missing", "resource_busy", "rate_limited", "network_transient"]
          candidate_failover_on: []          # 仅显式填入可用性类错误才生效
          contract_repair_on: ["contract_mismatch", "json_invalid"] # 合同错误先定向 repair

      tier2_challenger:                # Tier 2 辩护对抗 (Challenger 角色，快速多维度寻找防御依据)
        resource: "native"             # 推荐 Thin LLM 低延迟高吞吐
        resources: ["native", "agy"]   # 辩护对抗候选算力池
        timeout_seconds: 1200          # 辩护对抗单片超时 (秒)
        recovery:
          max_total_attempts: 3
          max_attempts_per_resource: 3
          max_candidate_failovers: 0
          retry_backoff_ms: 2000
          max_backoff_seconds: 15
          retry_on: ["idle_timeout", "timeout", "output_missing", "resource_busy", "rate_limited", "network_transient"]
          candidate_failover_on: []

      tier3_judge:                     # Tier 3 终审法官 (Judge 角色，旗舰模型独立权威仲裁)
        resource: "agy"                # 推荐旗舰推理模型或旗舰 Thick Agent
        resources: ["agy", "native"]   # 终审法官候选算力池
        timeout_seconds: 1800          # 终审裁决单片超时 (秒)
        recovery:
          max_total_attempts: 3
          max_attempts_per_resource: 3
          max_candidate_failovers: 0
          retry_backoff_ms: 2000
          max_backoff_seconds: 15
          retry_on: ["idle_timeout", "timeout", "output_missing", "resource_busy", "rate_limited", "network_transient"]
          candidate_failover_on: []

      tier4_synthesis:                 # Tier 4 全仓态势汇总 (Synthesis 角色，报告聚合)
        resource: "native"             # 显式精确绑定 native 算力集群
        resources: ["native"]
        timeout_seconds: 300           # 报告汇总超时 (秒)
        attempt_timeout_seconds: 300   # 单次 HTTP attempt 超时 (秒)
        first_byte_timeout_seconds: 60 # 流式首包看门狗 (秒)
        idle_timeout_seconds: 60       # 流式事件间空闲看门狗 (秒)
        recovery:
          max_total_attempts: 2
          max_attempts_per_resource: 2
          max_candidate_failovers: 0
          retry_backoff_ms: 2000
          max_backoff_seconds: 15
          retry_on: ["idle_timeout", "timeout", "output_missing", "resource_busy", "rate_limited", "network_transient"]
          candidate_failover_on: []

  # 确定性解码与跨轮可比性
  determinism:
    enabled: true
    temperature: 0.0
    bind_model_per_task: true
    prefer_seed: true
    seed_policy: "repo+task+commit+chunk"

  # 内置场景微任务路由 (Utility Tools Routing)
  tools:
    default_resource: "native"         # 默认统一走 native
    overrides:
      repair_json: "native"
      finding_match: "native"
      feedback_extraction: "native"

  # 扫描产物确定性修复与候选抢救
  artifact:
    normalization_enabled: true
    max_schema_repair_attempts: 2
    schema_repair_timeout_seconds: 600
    schema_repair_resource: "native"
    category_repair_enabled: true
    category_repair_timeout_seconds: 60
    category_repair_max_candidates: 20
    allow_candidate_salvage: true
    max_quarantined_candidate_ratio: 0.50

# ==============================================================================
# 4. 企业多任务治理与历史记忆闭环 (Enterprise Governance - 初次导入种子模版)
# 职责：专注解决“质量红线、缺陷指纹防抖、范围守卫、PR门禁与知识沉淀”
# ==============================================================================
governance:
  # 跨轮疑似重复缺陷仲裁
  arbitration:
    enabled: true
    max_calls_per_report: 20
    context_lines: 8
    timeout_seconds: 30
  # 分类语义回归批处理的成本与故障保护
  category_regression_batch_size: 50
  category_regression_max_failures: 5

# ==============================================================================
# 5. 事件通知服务 (Notification - 初次导入种子模版)
# ==============================================================================
notification:
  webhook: "http://127.0.0.1:8081/api/notify/email" # 通知回调地址

ai_fix:
  fix_url: "https://starmind-dev.sicarrier.com/shield-fix/fixdefect?id={defect_id}"
  context_token: "${AI_FIX_CONTEXT_TOKEN}"
  report_base_url: "https://code.sicarrier.com"

# ==============================================================================
# 6. 台账快照生命周期与稀疏存储 (Retention & Snapshot Lifecycle - 08号架构设计)
# ==============================================================================
retention:
  ledger_retention_days: 30             # 缺陷台账历史快照保留天数（默认 30 天）
  max_retained_scans_per_repo: 10       # 同一代码仓保底保留的最新完整扫描快照数（默认 10 轮）
  enable_sparse_scope: true             # 覆盖明细是否启用稀疏存储（默认 true，推荐开启）
  scope_manifest_dir: ""                # 覆盖清单全量压缩产物存储目录（留空则跟随 report artifacts 目录）
