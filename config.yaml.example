# ============================================================
# Code Shield 服务端配置模版文件 (config.yaml.example)
# 使用方法：复制本文件为 config.yaml，并根据实际情况修改配置值
# ============================================================

# ── HTTP 与基础服务 ──
server:
  port: ":8080"                  # 服务监听端口
  data_dir: "./data"             # 运行时数据根目录，自动存放 codes/ 缓存和 reports/ 报告（建议配置为绝对路径；tasks/ 模版随程序目录走，无需放入数据盘）
  # external_url: "http://127.0.0.1:8080"  # 外部访问基准 URL（邮件等通知链接跳转，缺省默认为本地端口地址）
  # worker_count: 5              # 全局任务并发数，默认 5
  # max_queue_size: 2000         # 任务排队最大上限，默认 2000，-1 表示不限制
  # gin_log: true                # 是否打印 GIN 框架请求日志，默认 false
  read_timeout: 120s           # 读取 HTTP 请求超时时间，默认 120s
  write_timeout: 120s          # 写入响应超时时间，默认 120s
  idle_timeout: 180s           # keep-alive 空闲连接超时时间，默认 180s

# ── 数据库 ──
database:
  host: "127.0.0.1"              # PostgreSQL 数据库主机地址
  port: 5432                     # PostgreSQL 端口
  user: "code_shield"            # 数据库用户名
  password: "code_shield_password" # 数据库密码
  dbname: "code_shield"          # 数据库名称
  sslmode: "disable"             # SSL 模式：disable, require, verify-ca, verify-full
  max_open_conns: 50             # 最大打开连接数
  max_idle_conns: 10             # 最大空闲连接数

# ── AI 引擎 ──
ai:
  backend: "claude"              # AI 驱动 CLI 后端：可选 claude、opencode 或 codex，默认 claude
  # debug_logs: true             # 是否输出 AI 引擎底层的 debug 级别日志，默认 false。开启后会在报告同级目录下生成 .debug.log 文件方便定位
  # output_format: "text"        # AI 输出的格式：text 或 json（对 claude 来说是 text/stream-json，对 opencode 来说是 default/json；codex 的输出格式由提示词契约控制，CLI 不使用 --json），默认 text
  # mock_on_missing_cli: true    # CLI 未安装时是否写入空发现模拟报告（默认 true，建议生产环境显式改为 false 以避免静默"全绿"）

  # ── 工作时间自动限流配置 (可选) ──
  # 开启后，系统将在指定的工作日与时间段内自动降低并发（如 10% 或 0% 暂停），非工作时间/夜间自动恢复 100% 满速。
  # work_hours_throttle:
  #   enabled: true                 # 是否启用工作时间自动限流，默认 false
  #   workdays: [1, 2, 3, 4, 5]     # 生效星期: 1=周一, 2=周二, 3=周三, 4=周四, 5=周五, 6=周六, 7=周日
  #   start_time: "09:00"           # 开始限流时刻 (HH:MM)
  #   end_time: "22:00"             # 结束限流时刻 (HH:MM)
  #   scale: 0.10                   # 工作时间内的并发比例 (0.10 代表 10%，0.0 代表完全暂停)

  # ── 多 LLM 服务器并发配置 (可选) ──
  # 启用多 LLM 服务器配置时，全局任务并发数限制会被本配置的并发总和自动拓展，
  # 每次 AI 扫描时根据后端类型自动映射对应的模型名称，精准控制每台服务器的并发负载。
  # 注：使用 Codex 引擎需确保环境中配置了 OPENAI_API_KEY（必需）与 OPENAI_BASE_URL（可选，用于自定义网关）。
  # models:
  #   - opencode: "models/glm5.1"
  #     claude: "glm5.1"
  #     codex: "gpt-5.6-sol"
  #     concurrent: 5
  #   - codex: "o3-mini"
  #     concurrent: 3

# ── 通知服务 ──
notification:
  webhook: "http://127.0.0.1:8081/api/notify/email"  # 分析完毕后发送报告卡片通知的回调地址

# ── 认证与单点登录配置 ──
auth:
  standalone_mode: false             # 是否以独立系统模式运行（false: 微前端模式，依赖主门户；true: 独立部署运行）
  jwt_secret: ""                     # JWT 签名密钥（用于校验由 code-bench 签发或本系统签发的 Token；留空则启动时随机生成临时密钥）
  password_login_enabled: true       # 独立模式下是否启用本地账号密码登录
  oauth2:                            # 独立模式下的企业 OAuth2/OIDC 单点登录配置
    enabled: false                   # 是否启用独立 SSO
    client_id: ""                    # Client ID
    client_secret: ""                # Client Secret
    auth_url: ""                     # Authorization Endpoint
    token_url: ""                    # Token Endpoint
    userinfo_url: ""                 # UserInfo Endpoint
    redirect_url: ""                 # 回调地址，如 http://192.168.56.18:8080/api/oauth2/callback
    scopes: ["openid", "profile", "email"]
    admin_list:                      # 默认设为管理员的邮箱列表
      - "admin@code-shield.com"
    allowed_email_domains:           # 允许通过 SSO 登录的邮箱后缀白名单，留空表示不限制
      - "@yourcompany.com"
    field_mapping:
      username: "preferred_username"
      email: "email"
      name: "name"
      employee_id: "employee_id"
      unique_id: "unique_id"
      employee_type: "employee_type"

