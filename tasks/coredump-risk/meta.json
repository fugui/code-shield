  "taxonomy": {
    "schema_version": 3,
    "categories": [
      {
        "code": "THREAD_DATA_RACE",
        "label": "多线程并发问题-数据竞争",
        "definition": "Unsynchronized concurrent access to shared mutable state where at least one access writes.",
        "decision_rules": [
          "shared state crosses threads",
          "at least one write",
          "no happens-before edge"
        ],
        "positive_hints": [
          "global or shared field",
          "worker/read-write access",
          "missing lock or memory barrier"
        ],
        "negative_hints": [
          "thread-local value",
          "immutable value",
          "fully guarded access"
        ],
        "priority": 100,
        "status": "active"
      },
      {
        "code": "THREAD_LOCK_SYNC",
        "label": "多线程并发问题-锁同步不当",
        "definition": "Incorrect lock selection, scope, ordering, or release that fails to protect shared state.",
        "decision_rules": [
          "lock or synchronization exists",
          "protection is incomplete or mismatched",
          "race remains possible"
        ],
        "positive_hints": [
          "different locks protect one object",
          "lock released before dependent use",
          "partial critical section"
        ],
        "negative_hints": [
          "consistent critical section",
          "lock held through dependent use"
        ],
        "priority": 95,
        "status": "active"
      },
      {
        "code": "THREAD_DEADLOCK",
        "label": "多线程并发问题-死锁风险",
        "definition": "Threads can hold locks or resources while waiting for each other in a cyclic dependency.",
        "decision_rules": [
          "two or more resources",
          "locks acquired in inconsistent order",
          "waiting can form a cycle"
        ],
        "positive_hints": [
          "nested locks",
          "inverse acquisition order",
          "conditional wait inside lock"
        ],
        "negative_hints": [
          "single lock",
          "global lock hierarchy",
          "try-lock rollback"
        ],
        "priority": 90,
        "status": "active"
      },
      {
        "code": "MEM_NULL_DEREF",
        "label": "内存管理问题-空指针解引用",
        "definition": "A pointer that may be null is dereferenced without a sufficient guard.",
        "decision_rules": [
          "pointer can be null on path",
          "no effective null check",
          "dereference occurs"
        ],
        "positive_hints": [
          "allocations checked elsewhere only",
          "error return leaves null",
          "unchecked map or getter result"
        ],
        "negative_hints": [
          "definite non-null invariant",
          "guard rejects null",
          "allocation failure aborts"
        ],
        "priority": 85,
        "status": "active"
      },
      {
        "code": "MEM_BUFFER_OVERFLOW",
        "label": "内存管理问题-越界访问/缓冲区溢出",
        "definition": "Access exceeds allocated bounds of an array, buffer, string, or container.",
        "decision_rules": [
          "index or length is attacker/path dependent",
          "bound is wrong or missing",
          "write or read exceeds allocation"
        ],
        "positive_hints": [
          "off-by-one",
          "untrusted size",
          "strcpy, memcpy, or pointer arithmetic"
        ],
        "negative_hints": [
          "checked bounds",
          "allocation covers requested range"
        ],
        "priority": 80,
        "status": "active"
      },
      {
        "code": "MEM_DOUBLE_FREE",
        "label": "内存管理问题-双重释放",
        "definition": "Owned memory is deallocated twice or ownership is released through two paths.",
        "decision_rules": [
          "same allocation reaches free twice",
          "no ownership handoff",
          "pointer is not cleared"
        ],
        "positive_hints": [
          "error and success paths free",
          "copy of raw owner",
          "explicit delete in destructor and caller"
