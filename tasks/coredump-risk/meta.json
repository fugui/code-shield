{
  "name": "coredump_risk",
  "display_name": "Coredump 风险分析",
  "description": "专项分析 C/C++ 代码中可能引发进程崩溃（Coredump）的高危风险，如空指针解引用、缓冲区溢出、野指针、除零异常及未捕获信号等问题",
  "engine_mode": "debate_full",
  "engine_config": {
    "file_extensions": [
      ".c",
      ".cpp",
      ".cc",
      ".cxx",
      ".h",
      ".hpp",
      ".hxx"
    ],
    "exclude_paths": [
      "thirdparts"
    ]
  },
  "target_scope": "business",
  "notify_template": "【Code-Shield】{{.RepoName}} {{.TaskDisplayName}}报告",
  "notify_threshold": 10,
  "notify_cc": [],
  "timeout": 60,
  "is_campaign": true,
  "campaign_path": "coredump",
  "governance_mode": "defect_tracking",
  "categories": [
    "空指针解引用",
    "越界访问",
    "释放后使用",
    "双重释放",
    "数据竞争与多线程安全",
    "信号处理不安全",
    "未初始化变量",
    "资源或内存泄漏",
    "除零错误",
    "死锁风险",
    "其它缺陷"
  ],
  "is_active": true
}