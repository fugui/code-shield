{
  "name": "thread_create",
  "display_name": "新建线程分析",
  "description": "分析 C/C++ 代码中显式创建线程的合理性与生命周期管理方式",
  "engine_mode": "chunked_fast",
  "engine_config": {
    "file_extensions": [
      ".c",
      ".cpp",
      ".cc",
      ".cxx",
      ".h",
      ".hpp",
      ".hxx"
    ],
    "content_keywords": [
      "pthread_create",
      "std::thread",
      "std::jthread",
      "std::async",
      "QThread",
      "omp parallel",
      "boost::asio::thread_pool",
      "CFThreadCreate"
    ],
    "exclude_paths": [
      "thirdparts"
    ]
  },
  "target_scope": "business",
  "notify_template": "【Code-Shield】{{.RepoName}} {{.TaskDisplayName}}报告",
  "notify_threshold": 10,
  "notify_cc": [],
  "timeout": 60,
  "is_campaign": true,
  "campaign_path": "thread",
  "governance_mode": "defect_tracking",
  "domain_family": "architecture_governance",
  "defense_dimensions": [
    {
      "dimension": "ScopeExemption",
      "description": "属于单测桩代码、本地离线排障脚本或内部辅助工具，无生产环境线上影响"
    },
    {
      "dimension": "ThirdPartyLib",
      "description": "属于第三方开源组件或外部库底层封装，内部线程创建行为无法侵入改动"
    },
    {
      "dimension": "RAIILifetime",
      "description": "已封装自研统一 RAII 资源管理类自动执行 join/detach，无崩溃泄露风险"
    }
  ],

  "categories": [
    "无问题",
    "必要性-频繁创建",
    "必要性-未使用平台调度组",
    "必要性-未使用平台定时器",
    "生命周期-join遗漏",
    "生命周期-未安全退出",
    "异常安全-析构崩溃",
    "数据安全-悬空引用",
    "同步安全-数据竞争",
    "其它"
  ],
  "is_active": true
}